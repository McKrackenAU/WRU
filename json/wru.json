{
  "name": "WRU",
  "slug": "wru",
  "categories": ["Productivity", "Other"],
  "date_created": "2026-07-29",
  "type": "ct",
  "updateable": true,
  "privileged": false,
  "interface_port": 8000,
  "documentation": "https://github.com/McKrackenAU/WRU",
  "website": "https://github.com/McKrackenAU/WRU",
  "description": "Lightweight LCP-FMRP MoA / roadwork site tracker with custom columns, tracking notes, and document attachments.",
  "install_methods": [
    {
      "type": "default",
      "script": "ct/wru.sh",
      "resources": {
        "cpu": 1,
        "ram": 2048,
        "hdd": 8,
        "os": "debian",
        "version": "12"
      }
    }
  ],
  "config_path": "/etc/default/wru",
  "notes": [
    {
      "text": "Uses local PostgreSQL (db/user wru). Credentials in /etc/default/wru",
      "type": "info"
    },
    {
      "text": "Uploads persist in /opt/wru-data/uploads",
      "type": "info"
    },
    {
      "text": "Re-run the script inside the container to update WRU",
      "type": "info"
    }
  ]
}
